# ---------------------------------------------------------------------------
# UpNext Marketing — environment variables
# Copy this file to `.env.local` and fill in the values. See README §Form.
# ---------------------------------------------------------------------------

# GoHighLevel inbound webhook URL. Get it from GHL:
#   Automation > Workflows > new workflow > trigger "Inbound Webhook" > copy URL.
# Leave blank in development — the form will still work and log the payload
# to your terminal instead of sending it anywhere.
GHL_WEBHOOK_URL=

# OPTIONAL: use a GoHighLevel-hosted form/survey iframe instead of the custom
# two-step form. If set, the embed replaces the custom form everywhere.
# Leave blank to use the custom two-step form (recommended — higher completion).
NEXT_PUBLIC_GHL_FORM_EMBED_URL=

# OPTIONAL: public site URL, used for metadata/OpenGraph absolute links.
NEXT_PUBLIC_SITE_URL=https://upnextmarketing.com
